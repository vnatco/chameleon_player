{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chameleon Player",
  "mainBinaryName": "chameleon",
  "version": "1.0.1",
  "identifier": "co.vnat.chameleon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chameleon Player",
        "width": 860,
        "height": 860,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "center": true,
        "dragDropEnabled": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://coverartarchive.org https://*.archive.org",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Music",
    "shortDescription": "Cover-first, chameleon music player",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "vnat.co",
    "homepage": "https://github.com/vnatco/chameleonplayer",
    "copyright": "Copyright 2026 Vladimer Natchkepia",
    "longDescription": "A cover-first music player for Windows. The album cover is the player, and the whole interface takes its colors from the artwork.",
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ],
        "name": "ChameleonPlayer.MP3",
        "description": "MP3 Audio",
        "role": "Viewer",
        "mimeType": "audio/mpeg"
      },
      {
        "ext": [
          "m4a",
          "m4b"
        ],
        "name": "ChameleonPlayer.M4A",
        "description": "MPEG-4 Audio",
        "role": "Viewer",
        "mimeType": "audio/mp4"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "ChameleonPlayer.FLAC",
        "description": "FLAC Audio",
        "role": "Viewer",
        "mimeType": "audio/flac"
      },
      {
        "ext": [
          "ogg",
          "oga"
        ],
        "name": "ChameleonPlayer.OGG",
        "description": "Ogg Vorbis Audio",
        "role": "Viewer",
        "mimeType": "audio/ogg"
      },
      {
        "ext": [
          "wav"
        ],
        "name": "ChameleonPlayer.WAV",
        "description": "WAV Audio",
        "role": "Viewer",
        "mimeType": "audio/wav"
      },
      {
        "ext": [
          "aac"
        ],
        "name": "ChameleonPlayer.AAC",
        "description": "AAC Audio",
        "role": "Viewer",
        "mimeType": "audio/aac"
      },
      {
        "ext": [
          "aif",
          "aiff",
          "aifc"
        ],
        "name": "ChameleonPlayer.AIFF",
        "description": "AIFF Audio",
        "role": "Viewer",
        "mimeType": "audio/aiff"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}